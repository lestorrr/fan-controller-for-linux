def parse_set(values):
    """--set key=value: values are JSON when they parse (60, true, [...]), else strings."""
    out = {}
    for item in values or ():
        key, sep, value = item.partition("=")
        if not sep or not key:
            raise ValueError(f"--set expects key=value, got {item!r}")
        try:
            out[key] = json.loads(value)
        except ValueError:
            out[key] = value
    return out


def simulate_main(args):
    try:
        overrides = parse_set(args.set)
    except ValueError as e:
        sys.stderr.write(f"{e}\n")
        return 2
    legacy = bool(overrides.pop("legacy", 0))
    base = None
    if args.config:
        raw, _mtime, err = read_config_file(args.config)
        if raw is None:
            sys.stderr.write(f"cannot read {args.config}: {err}\n")
            return 2
        base = config_from_disk(raw, None)
    cfg, rejected = sanitize(overrides, base)
    if rejected:
        sys.stderr.write(f"warning: --set ignored for {', '.join(rejected)}\n")
    try:
        rows = load_trace(args.simulate)
    except (OSError, ValueError) as e:
        sys.stderr.write(f"cannot load trace {args.simulate}: {e}\n")
        return 2
    if not rows:
        sys.stderr.write(f"trace {args.simulate} has no usable rows\n")
        return 2
    echo = None if (args.json or args.quiet) else sys.stdout
    summary = simulate(rows, cfg, legacy=legacy, open_loop=args.open_loop, echo=echo,
                       detail=args.detail)
    if args.json:
        sys.stdout.write(json.dumps(summary, separators=(",", ":")) + "\n")
    else:
        print_summary(summary, sys.stdout)
    return 0


def gen_trace_main(args):
    try:
        rows = gen_scenario(args.gen_trace, args.seconds, args.seed)
    except ValueError as e:
        sys.stderr.write(f"{e}\n")
        return 2
    write_trace_csv(rows, sys.stdout)
    return 0


def build_parser():
    p = argparse.ArgumentParser(
        prog="thinkpad-fan-controld",
        description="ThinkPad fan control daemon v2 (docs/CONTRACT.md §13). "
                    "Without options: run as the systemd service.")
    p.add_argument("--version", action="store_true", help="print the version and exit")
    p.add_argument("--save-config", action="store_true",
                   help="stdin JSON -> config.json; prints {\"config\", \"rejected\"}")
    p.add_argument("--self-test", action="store_true",
                   help="hardware wait + level write-back + one state.json; no sound")
    p.add_argument("--simulate", metavar="TRACE", help="trace.csv or history.json")
    p.add_argument("--config", metavar="FILE", help="--simulate: config file (default: DEFAULTS)")
    p.add_argument("--set", action="append", metavar="KEY=VALUE",
                   help="--simulate: override a config key; legacy=1 runs the v1 rules")
    p.add_argument("--json", action="store_true", help="--simulate: one JSON summary line")
    p.add_argument("--quiet", action="store_true", help="--simulate: summary only")
    p.add_argument("--detail", action="store_true",
                   help="--simulate --json: include per-tick records, events and log lines")
    p.add_argument("--open-loop", action="store_true",
                   help="--simulate: replay the recorded temperatures even if p_w is present")
    p.add_argument("--gen-trace", metavar="SCENARIO", choices=SCENARIOS,
                   help="print a synthetic trace CSV: " + "|".join(SCENARIOS))
    p.add_argument("--seconds", type=int, default=3600, help="--gen-trace length (default 3600)")
    p.add_argument("--seed", type=int, default=1, help="--gen-trace seed (default 1)")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if args.version:
        sys.stdout.write(f"thinkpad-fan-controld {VERSION}\n")
        return 0
    if args.save_config:
        return save_config_main()
    if args.self_test:
        return self_test_main()
    if args.simulate:
        return simulate_main(args)
    if args.gen_trace:
        return gen_trace_main(args)
    return run_daemon()


if __name__ == "__main__":
    sys.exit(main())
