# ── Trace generator (§13) ────────────────────────────────────────────────────

SCENARIOS = ("idle", "load12", "load15", "load18", "stop", "ramp", "acflip",
             "sensorloss", "override")
TRACE_COLUMNS = ("t_s", "cpu", "igpu", "ac", "sensor_ok", "cpu_ok", "p_w", "spike_c",
                 "model_c", "hold_level", "hold_seconds")


def _bursts(n, idle, rng):
    """
    Tctl bursts: +5..14 C for 1-3 s, about every 25 s under load and every
    60 s idle; while idle also +8 C load bursts of 3-6 s every 15-40 s.
    """
    spike = [0.0] * n
    t = rng.uniform(5.0, 25.0)
    while t < n:
        i = int(t)
        amp = rng.uniform(5.0, 14.0)
        dur = rng.randint(1, 3)
        for k in range(i, min(n, i + dur)):
            spike[k] = max(spike[k], amp)
        mean = 60.0 if idle[i] else 25.0
        t = i + dur + rng.uniform(0.6 * mean, 1.4 * mean)
    t = rng.uniform(15.0, 40.0)
    while t < n:
        i = int(t)
        if not idle[i]:
            t = i + 1
            continue
        dur = rng.randint(3, 6)
        for k in range(i, min(n, i + dur)):
            if idle[k]:
                spike[k] += 8.0
        t = i + dur + rng.uniform(15.0, 40.0)
    return spike


def _row(t):
    return {"t": float(t), "cpu": None, "igpu": None, "ac": True, "sensor_ok": True,
            "cpu_ok": True, "p_w": None, "spike": 0.0, "model": None, "hold": None}


def gen_scenario(kind, seconds, seed):
    """
    Deterministic per seed: only random.Random(seed) is consulted.  Returns
    rows for load_trace()'s format.  All scenarios except `ramp` are closed
    loop (power + bursts; the reference cpu/igpu/model columns come from the
    default controller in the loop); `ramp` is a scripted temperature path.
    """
    if kind not in SCENARIOS:
        raise ValueError(f"unknown scenario {kind!r}; expected one of {', '.join(SCENARIOS)}")
    n = max(120, int(seconds))
    rng = random.Random(seed)
    rows = [_row(t) for t in range(n)]
    idle = [False] * n
    t0_temp = 50.0

    def walk(lo, hi, start, step=0.05):
        p = start
        for r in rows:
            p = min(hi, max(lo, p + rng.uniform(-step, step)))
            r["p_w"] = round(p, 3)

    if kind == "idle":
        idle = [True] * n
        walk(3.0, 4.0, 3.5)
        t0_temp = 48.0
    elif kind in ("load12", "load15", "load18"):
        base = float(kind[4:])
        walk(base - 0.3, base + 0.3, base)
    elif kind == "stop":
        # 17 W holds the fan at the top step (disengaged settles near 74 C,
        # above its 72 C release), so the load ends there and the whole
        # dis -> 7 -> 6 -> 4 cascade is exercised.
        end = max(120, int(n * 0.4))
        for t, r in enumerate(rows):
            r["p_w"] = 17.0 if t < end else 2.5
            idle[t] = t >= end
    elif kind == "ramp":
        # Scripted open-loop excursion: 65 C, a 0.5 C/s ramp through 90 (the
        # noise is smaller than the slope, so the first readings >= 90 are
        # consecutive), a 92-94 C plateau long enough for repeat alerts, a
        # slow decline, then 60 C.
        a = int(n * 0.05)
        plateau_end = a + 58 + int(n * 0.30)
        decline_end = plateau_end + 340
        for t, r in enumerate(rows):
            if t < a:
                temp = 65.0
            elif t < a + 58:
                temp = 65.0 + 0.5 * (t - a)
            elif t < plateau_end:
                temp = 93.0 + rng.uniform(-1.0, 1.0)
            elif t < decline_end:
                temp = 94.0 - 0.1 * (t - plateau_end)
            else:
                temp = 60.0
            temp += rng.uniform(-0.2, 0.2)
            r["cpu"] = round(temp, 2)
            r["igpu"] = round(temp - 1.0, 2)
        return rows
    elif kind == "acflip":
        walk(8.7, 9.3, 9.0)
        t0_temp = 60.0
        on_battery = set(range(n // 3, 2 * n // 3))
        on_battery.add(n // 6)                           # 1-sample bounce
        on_battery.discard(n // 2)                       # 1-sample bounce back to AC
        on_battery.update((5 * n // 6, 5 * n // 6 + 1))  # 2-sample bounce
        for t, r in enumerate(rows):
            r["ac"] = t not in on_battery
    elif kind == "sensorloss":
        walk(9.7, 10.3, 10.0)
        t0_temp = 60.0
        lost = {n // 6} | {n // 4, n // 4 + 1} | set(range(n // 3, n // 3 + 30))
        for t, r in enumerate(rows):
            r["sensor_ok"] = t not in lost
            r["cpu_ok"] = not (int(n * 0.2) <= t < int(n * 0.2) + 5)
    elif kind == "override":
        # Phases: idle; a hold at level 3 issued at t=60 under 9 W (the die
        # settles near 75 C, so a +14 C Tctl burst reads >= 85 while T_fast
        # stays below the 82 C ceiling); 16 W, which pushes T_fast over the
        # ceiling (suspension and resumption); a 90 s 32 W burst into
        # critical; 8 W until and past the hold's expiry at 0.6 n + 60.
        t0_temp = 48.0
        b, c = int(n * 0.25), int(n * 0.45)
        for t, r in enumerate(rows):
            r["p_w"] = 6.0 if t < 60 else 9.0 if t < b else 16.0 if t < c else \
                32.0 if t < c + 90 else 8.0
            idle[t] = t < 60
        rows[60]["hold"] = ("3", int(n * 0.6))
    spike = _bursts(n, idle, rng)
    if kind == "override":
        # One guaranteed 85 C-class Tctl burst while the hold should still be
        # in force (§13: "level held through 85 C").
        k = int(n * 0.15)
        for i in range(k, min(n, k + 3)):
            spike[i] = max(spike[i], 14.0)
    for t, r in enumerate(rows):
        r["spike"] = round(spike[t], 2)
    rows[0]["model"] = t0_temp
    ref = simulate(rows, sanitize({})[0], detail=True)
    for r, tk in zip(rows, ref["ticks"]):
        r["model"] = tk["model"]
        if r["sensor_ok"]:
            r["cpu"] = round(tk["model"] + r["spike"], 2) if r["cpu_ok"] else None
            r["igpu"] = round(tk["model"] - 1.0, 2)
    rows[0]["model"] = t0_temp
    return rows


def write_trace_csv(rows, out):
    w = csv.writer(out, lineterminator="\n")
    w.writerow(TRACE_COLUMNS)
    for r in rows:
        hold = r["hold"] or ("", "")
        w.writerow([int(r["t"]), "" if r["cpu"] is None else r["cpu"],
                    "" if r["igpu"] is None else r["igpu"], int(r["ac"]), int(r["sensor_ok"]),
                    int(r["cpu_ok"]), "" if r["p_w"] is None else r["p_w"], r["spike"],
                    "" if r["model"] is None else r["model"], hold[0], hold[1]])


