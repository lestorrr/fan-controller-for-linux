def _as_int(value):
    """Ints and integral floats (JSON 50.0) only; bools and strings are not numbers here."""
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float) and value.is_integer() and abs(value) < 1e9:
        return int(value)
    return None


def _as_bool(value):
    if isinstance(value, bool):
        return value
    if type(value) is int and value in (0, 1):
        return bool(value)
    return None


def _ranged(lo, hi):
    def check(value):
        v = _as_int(value)
        return v if v is not None and lo <= v <= hi else None
    return check


def _valid_watchdog(value):
    v = _as_int(value)
    return v if v is not None and (v == 0 or 15 <= v <= 120) else None


def _valid_alert_sound(value):
    # Absolute, bounded, no control characters: the string becomes an argv
    # element of a media player running in the desktop session.
    if (isinstance(value, str) and value.startswith("/") and len(value) <= 400
            and not any(ord(ch) < 32 or ord(ch) == 127 for ch in value)):
        return value
    return None


def valid_curve(raw):
    """
    Normalise a curve or return None when it breaks a hard rule (§3).

    Any violation rejects the whole curve: accepting part of it could drop
    exactly the step that keeps the machine cool.  Steps must already be in
    order; steps[0].temp is forced to 0 because the base step always applies.
    """
    if not isinstance(raw, list) or not 1 <= len(raw) <= 8:
        return None
    steps = []
    for item in raw:
        if not isinstance(item, dict):
            return None
        temp = _as_int(item.get("temp"))
        level = item.get("level")
        if temp is None or not 0 <= temp <= 105:
            return None
        if not isinstance(level, str) or level not in VALID_LEVELS:
            return None
        step = {"temp": temp, "level": level}
        if item.get("down") is not None:
            down = _as_int(item["down"])
            if down is None:
                return None
            step["down"] = down
        steps.append(step)
    steps[0]["temp"] = 0
    # The base step is never released from (release_temp(0) is None), so a
    # `down` there means nothing; it is dropped the same way its temperature
    # is forced to 0 rather than failing the whole curve over a no-op field.
    steps[0].pop("down", None)
    for i, step in enumerate(steps):
        if i > 0:
            if step["temp"] <= steps[i - 1]["temp"]:
                return None
            if step["level"] == "auto":
                return None
            if RANK[step["level"]] < RANK[steps[i - 1]["level"]]:
                return None
        if step["temp"] >= 60 and RANK[step["level"]] < 1:
            return None
        if "down" in step:
            # Exactly the §3 bound, so the dashboard's validator and this one
            # agree.  A negative value is only reachable for a step below
            # 20 C, which the die never leaves anyway; pinning it is harmless.
            if not step["temp"] - 20 <= step["down"] <= step["temp"] - 1:
                return None
    return steps


VALIDATORS = {key: _ranged(lo, hi) for key, (lo, hi) in INT_RANGES.items()}
