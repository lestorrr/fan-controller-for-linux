def same_level(a, b):
    """thinkpad_acpi reads `full-speed` back as `disengaged` (same EC bit)."""
    return a == b or {a, b} <= {"disengaged", "full-speed"}


class GuiIdentity:
    """
    Who the GUI runs as (§2).  It comes from daemon.env (root-owned, read via
    EnvironmentFile=), never from the GUI-writable config.json, because it
    decides who may talk to the socket and whose session hears the alert.
    """

    def __init__(self, environ=None):
        env = os.environ if environ is None else environ
        self.uid = _env_id(env.get("FANCTL_GUI_UID"), 1000)
        self.gid = _env_id(env.get("FANCTL_GUI_GID"), 1000)
        home = env.get("FANCTL_GUI_HOME") or ""
        if not home.startswith("/"):
            try:
                home = "/home/" + pwd.getpwuid(self.uid).pw_name
            except KeyError:
                home = "/"
        self.home = home
        runtime = env.get("FANCTL_GUI_RUNTIME_DIR") or ""
        self.runtime_dir = runtime if runtime.startswith("/") else f"/run/user/{self.uid}"


def _env_id(value, default):
    try:
        v = int(str(value).strip())
    except (TypeError, ValueError):
        return default
    return v if 0 <= v < 2 ** 31 else default


