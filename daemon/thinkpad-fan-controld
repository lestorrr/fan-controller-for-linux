VALIDATORS.update({
    "watchdog": _valid_watchdog,
    "alert_sound": _valid_alert_sound,
    "curve": valid_curve,
    "battery_curve": valid_curve,
})


def sanitize(raw, base=None):
    """
    The only config validator that matters (§3).  Returns (config, rejected).

    Precedence per key: a valid value in `raw`; else the value in `base` (the
    config on disk / in force) when that is itself valid; else DEFAULTS.  An
    out-of-range value is invalid, not clamped: a hostile or buggy write then
    changes nothing, and the key is listed in `rejected` so the GUI can say so.
    Unknown keys are dropped (and reported).
    """
    cfg = copy.deepcopy(DEFAULTS)
    rejected = []
    for source, report in ((base, False), (raw, True)):
        if not isinstance(source, dict):
            continue
        for key, validator in VALIDATORS.items():
            if key not in source:
                continue
            value = validator(source[key])
            if value is None:
                if report:
                    rejected.append(key)
            else:
                cfg[key] = copy.deepcopy(value)

    # override_ceiling_temp is only meaningful relative to the final
    # critical_temp, so it is resolved last: raw, else base, else crit - 8
    # (always inside 60..crit-1 because crit >= 70).
    crit = cfg["critical_temp"]
    ceiling = crit - 8
    for source, report in ((base, False), (raw, True)):
        if isinstance(source, dict) and "override_ceiling_temp" in source:
            v = _as_int(source["override_ceiling_temp"])
            if v is not None and 60 <= v <= crit - 1:
                ceiling = v
            elif report:
                rejected.append("override_ceiling_temp")
    cfg["override_ceiling_temp"] = ceiling

    # An armed EC watchdog must outlive three missed samples plus the refresh
    # slack, or the EC would drop to auto between two of our writes.
    if cfg["watchdog"] > 0:
        cfg["watchdog"] = max(cfg["watchdog"], 3 * cfg["sample_interval"] + 15)

    cfg["schema"] = 2
    if isinstance(raw, dict):
        known = set(DEFAULTS) | SILENT_KEYS
        rejected.extend(key for key in raw if key not in known)
    out = []
    for key in rejected:
        if key not in out:
            out.append(key)
    return cfg, out


def migrate_v1(raw, note=None):
    """
    v1 (no `schema`) -> v2 (§3).  Returns a new dict and never mutates `raw`.
    `note(msg)` is called when the watchdog gets switched on, so the caller
    can log that once.
    """
    out = {k: copy.deepcopy(v) for k, v in raw.items() if k != "poll_interval"}
    if "watchdog" in out and _as_int(out["watchdog"]) == 0:
        out["watchdog"] = 60
        if note is not None:
            note("watchdog enabled (60 s) by upgrade")
    for key, old, new in (("curve", V1_DEFAULT_CURVE, DEFAULTS["curve"]),
                          ("battery_curve", V1_DEFAULT_BATTERY_CURVE,
                           DEFAULTS["battery_curve"])):
        if out.get(key) == old:
            out[key] = copy.deepcopy(new)
    out["schema"] = 2
    return out


def curve_summary(curve):
    """`0:auto 50:4 60:6 70:7 80/72:disengaged` (§10)."""
    return " ".join(f"{s['temp']}/{s['down']}:{s['level']}" if "down" in s
                    else f"{s['temp']}:{s['level']}" for s in curve)

