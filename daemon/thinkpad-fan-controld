class Log:
    """
    `[YYYY-mm-dd HH:MM:SS] message`, one append per line (§10), so logrotate
    can rename the file without signalling us.

    warn() rate-limits identical text to once per 60 s and appends `(xN)`
    (occurrences since the last written copy) when it is written again, so a
    stuck sensor or a failing fan write cannot flood the file at 1 Hz.
    once() writes a given text a single time per process.
    """

    RATE_LIMIT_S = 60

    def __init__(self, path=None, clock=None, echo=None, collect=False):
        self.path = path
        self.clock = clock or SystemClock()
        self.echo = echo
        self.lines = [] if collect else None
        self._recent = {}               # text -> [last_written_mono, suppressed]
        self._once = set()

    def _emit(self, msg):
        stamp = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(self.clock.time()))
        line = f"[{stamp}] {msg}\n"
        if self.lines is not None:
            self.lines.append(line.rstrip("\n"))
        if self.echo is not None:
            self.echo.write(line)
            self.echo.flush()
        if self.path:
            try:
                self._append(line)
            except OSError:
                # Never stdout: --save-config's stdout carries exactly one JSON line.
                sys.stderr.write(line)
                sys.stderr.flush()

    def _append(self, line):
        try:
            fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_EXCL, 0o644)
            # Created by us under UMask=0077: make it readable for the GUI.
            os.fchmod(fd, 0o644)
        except FileExistsError:
            fd = os.open(self.path, os.O_WRONLY | os.O_APPEND)
        with open(fd, "a", encoding="utf-8") as f:
            f.write(line)

    def info(self, msg):
        self._emit(msg)

    def once(self, msg):
        if msg not in self._once:
            self._once.add(msg)
            self._emit(msg)

    def warn(self, msg):
        now = self.clock.monotonic()
        entry = self._recent.get(msg)
        if entry is not None and now - entry[0] < self.RATE_LIMIT_S:
            entry[1] += 1
            return
        suffix = f" (x{entry[1] + 1})" if entry is not None and entry[1] else ""
        self._recent[msg] = [now, 0]
        if len(self._recent) > 256:
            self._recent = {k: v for k, v in self._recent.items()
                            if now - v[0] < self.RATE_LIMIT_S}
        self._emit(msg + suffix)

    error = warn


class SystemClock:
    monotonic = staticmethod(time.monotonic)
    time = staticmethod(time.time)

