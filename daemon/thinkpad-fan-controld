def _write_all(fd, data):
    view = memoryview(data)
    while view:
        n = os.write(fd, view)
        view = view[n:]


def write_file_atomic(path, data, mode=0o644, durable=False):
    """
    tmp + os.replace, with the mode set by fchmod (the unit runs with
    UMask=0077, so the mode passed to open() alone would come out 0600).

    The temporary name is unique (mkstemp, O_EXCL): --self-test may write into
    /tmp, where a predictable name could be pre-created by another user.
    `durable` adds the fsyncs a config file deserves; tmpfs state does not.
    """
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(prefix="." + os.path.basename(path) + ".",
                               suffix=".tmp", dir=directory)
    try:
        try:
            os.fchmod(fd, mode)
            _write_all(fd, data)
            if durable:
                os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    if durable:
        try:
            dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
        except OSError:
            pass


def write_json_atomic(path, obj, durable=False):
    data = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    write_file_atomic(path, data, 0o644, durable)


def read_config_file(path=None):
    """(raw dict | None, mtime | None, error | None) without validating."""
    path = path or CONFIG_FILE
    try:
        with open(path, "rb") as f:
            mtime = os.fstat(f.fileno()).st_mtime
            data = f.read(1 << 20)
    except FileNotFoundError:
        return None, None, "missing"
    except OSError as e:
        return None, None, e.strerror or str(e)
    try:
        raw = json.loads(data.decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as e:
        return None, mtime, f"invalid JSON: {e}"
    if not isinstance(raw, dict):
        return None, mtime, "not a JSON object"
    return raw, mtime, None


def config_from_disk(raw, base, note=None):
    """On-disk document -> sanitized config; a v1 file is migrated first (§3)."""
    if "schema" not in raw:
        raw = migrate_v1(raw, note)
    return sanitize(raw, base)[0]


def load_config(log):
    """
    Startup load: (config, mtime, schema found on disk or None).  A missing or
    broken file yields DEFAULTS; mid-run reloads keep the running config
    instead (Controller._check_config).
    """
    raw, mtime, err = read_config_file()
    if raw is None:
        if err == "missing":
            log.info(f"No {CONFIG_FILE}; using defaults")
        else:
            log.warn(f"WARN: {CONFIG_FILE}: {err}; using defaults")
        return sanitize({})[0], mtime, None
    schema = _as_int(raw.get("schema")) if "schema" in raw else 1
    return config_from_disk(raw, None, log.once), mtime, schema


def save_config_main(stdin=None, stdout=None, stderr=None):
    """
    `--save-config` (§3): stdin JSON -> config.json, then exactly one JSON line
    `{"config": ..., "rejected": [...]}` on stdout (install.sh and fanlib parse
    the last stdout line).  Exit 0 on success, 1 on bad input or write error.

    Validation lives here rather than in the GUI so that the only code that can
    write the config is the same root-owned code that consumes it.
    """
    stdin = stdin or sys.stdin.buffer
    stdout = stdout or sys.stdout
    stderr = stderr or sys.stderr
    data = stdin.read(SAVE_CONFIG_MAX_BYTES + 1)
    if len(data) > SAVE_CONFIG_MAX_BYTES:
        stderr.write(f"input larger than {SAVE_CONFIG_MAX_BYTES} bytes\n")
        return 1
    try:
        raw = json.loads(data.decode("utf-8") if isinstance(data, bytes) else data)
    except (ValueError, UnicodeDecodeError) as e:
        stderr.write(f"invalid JSON: {e}\n")
        return 1
    if not isinstance(raw, dict):
        stderr.write("config must be a JSON object\n")
        return 1

    log = Log(LOG_FILE)
    on_disk, _mtime, err = read_config_file()
    if on_disk is None and err not in (None, "missing"):
        # Unreadable file on disk: the payload is applied over DEFAULTS.
        log.warn(f"WARN: {CONFIG_FILE}: {err}; saving over defaults")
    base = config_from_disk(on_disk, None, log.once) if on_disk is not None else None
    # §3 says the migration applies "whenever schema is missing".  A payload
    # is treated as a v1 document when it lacks `schema` AND either carries
    # the v1-only `poll_interval` (an old GUI still running during an upgrade)
    # or the file on disk is not v2 yet (install.sh feeding the old file back
    # through here).  A v2 GUI's partial update without `schema` is NOT
    # migrated: turning its explicit `watchdog: 0` ("Off") into 60, or its
    # deliberately chosen v1-shaped curve into the v2 default, would silently
    # undo the user's choice.
    if "schema" not in raw and ("poll_interval" in raw or on_disk is None
                                or "schema" not in on_disk):
        raw = migrate_v1(raw, log.once)
    cfg, rejected = sanitize(raw, base)
    try:
        directory = os.path.dirname(CONFIG_FILE)
        if not os.path.isdir(directory):
            os.makedirs(directory, exist_ok=True)
            os.chmod(directory, 0o755)     # the GUI reads config.json as the user
        write_json_atomic(CONFIG_FILE, cfg, durable=True)
    except OSError as e:
        stderr.write(f"cannot write {CONFIG_FILE}: {e}\n")
        return 1
    log.info("Config updated from GUI")
    stdout.write(json.dumps({"config": cfg, "rejected": rejected}, separators=(",", ":")) + "\n")
    stdout.flush()
    return 0


