def read_text(path, limit=65536):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read(limit).strip()
    except OSError:
        return None


class Hwmon:
    """Sensors are found by driver name: hwmonN numbering changes across boots."""

    def __init__(self):
        self._dirs = {}

    def _scan(self):
        found = {}
        for d in sorted(glob.glob(os.path.join(HWMON_ROOT, "hwmon*"))):
            name = read_text(os.path.join(d, "name"))
            if name and name not in found:
                found[name] = d
        self._dirs = found

    def dir(self, name):
        d = self._dirs.get(name)
        if d is None or read_text(os.path.join(d, "name")) != name:
            self._scan()
            d = self._dirs.get(name)
        return d

    def temp(self, name, attr="temp1_input"):
        """Float degrees C (no integer truncation, §4) or None when invalid."""
        d = self.dir(name)
        if d is None:
            return None
        value = read_text(os.path.join(d, attr))
        try:
            c = int(value) / 1000.0
        except (TypeError, ValueError):
            return None
        # A disconnected sensor reads 0; that must never look "cool".
        return c if 0 < c < 150 else None


_COMMANDS_LEVEL = re.compile(r"^commands:\s*level\b")


def parse_fan_proc(text):
    """
    /proc/acpi/ibm/fan -> {status, speed, level, control_available}.

    `status: disabled` is the EC fan-status byte reading 0, i.e. the fan is
    stopped at level 0; it says nothing about whether we may control the fan.
    Control is available exactly when thinkpad_acpi (fan_control=1) prints a
    `commands:` line offering `level <level>` (§4.9 / §5 as amended).
    """
    out = {"status": None, "speed": None, "level": None, "control_available": False}
    if not text:
        return out
    for line in text.splitlines():
        if _COMMANDS_LEVEL.match(line):
            out["control_available"] = True
            continue
        key, sep, value = line.partition(":")
        if not sep:
            continue
        key, value = key.strip(), value.strip()
        if key == "status":
            out["status"] = value or None
        elif key == "level":
            out["level"] = value or None
        elif key == "speed":
            try:
                out["speed"] = int(value)
            except ValueError:
                pass
    return out


def sd_notify(message):
    """Type=notify plumbing; a no-op outside systemd."""
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr.startswith("@"):
        addr = "\0" + addr[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.sendto(message.encode("utf-8"), addr)
    except OSError:
        pass


def readable_by(path, uid, gid):
    """
    Could a process with exactly (uid, gid) and no supplementary groups read
    `path`?  That is the alert player's identity (§8: extra_groups=[]).  The
    daemon itself is root, so os.access() would always say yes.
    """
    def allowed(st, bit_user, bit_group, bit_other):
        if st.st_uid == uid:
            return bool(st.st_mode & bit_user)
        if st.st_gid == gid:
            return bool(st.st_mode & bit_group)
        return bool(st.st_mode & bit_other)

    try:
        real = os.path.realpath(path)
        st = os.stat(real)
        if not stat.S_ISREG(st.st_mode) or not allowed(st, stat.S_IRUSR, stat.S_IRGRP, stat.S_IROTH):
            return False
        parent = os.path.dirname(real)
        while True:
            pst = os.stat(parent)
            if not allowed(pst, stat.S_IXUSR, stat.S_IXGRP, stat.S_IXOTH):
                return False
            if parent == "/":
                return True
            parent = os.path.dirname(parent)
    except OSError:
        return False


class AlertPlayer:
    """
    §8: play the alert as the GUI user via Popen(user=, group=), no sudo.

    Children are tracked from the main loop: a paplay that exits non-zero
    within 2 s (cannot decode or cannot reach the sound server) is retried
    with gst-play-1.0; if that fails too, the fallback wav is played with
    paplay.  That last stage goes beyond §8 in the safe direction: a critical
    alert that stays silent because a user's mp3 is broken is worse than the
    wrong sound.  Players still running after 30 s are killed.  Failures go
    through the rate-limited WARN path, so each appears once.
    """

    def __init__(self, gui, log, clock=None):
        self.gui = gui
        self.log = log
        self.clock = clock or SystemClock()
        self.children = []

    def _env(self):
        rt = self.gui.runtime_dir
        return {"XDG_RUNTIME_DIR": rt, "PULSE_SERVER": f"unix:{rt}/pulse/native",
                "PATH": "/usr/bin:/bin", "HOME": self.gui.home}

    def _spawn(self, argv, path, stage):
        try:
            proc = subprocess.Popen(
                argv, user=self.gui.uid, group=self.gui.gid, extra_groups=[],
                cwd="/", env=self._env(), stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True, close_fds=True)
        except (OSError, ValueError, subprocess.SubprocessError) as e:
            self.log.warn(f"WARN: cannot start alert player {argv[0]}: {e}")
            return False
        self.children.append({"proc": proc, "path": path, "stage": stage,
                              "started": self.clock.monotonic()})
        return True

    def play(self, path):
        if self.gui.uid == 0:
            # Never run a media decoder as root, whatever daemon.env says.
            self.log.warn("WARN: FANCTL_GUI_UID is 0; alert sound not played")
            return
        if not readable_by(path, self.gui.uid, self.gui.gid):
            self.log.warn(f"WARN: alert sound {path} is not readable by uid "
                          f"{self.gui.uid}; using {FALLBACK_WAV}")
            path = FALLBACK_WAV
        self._spawn(["paplay", path], path, "paplay")

    def _next(self, child, age):
        if child["stage"] == "paplay" and age <= ALERT_FALLBACK_WINDOW_S:
            return ["gst-play-1.0", "--no-interactive", "--volume=1.0", child["path"]], \
                child["path"], "gst-play-1.0"
        if child["stage"] == "gst-play-1.0" and child["path"] != FALLBACK_WAV:
            return ["paplay", FALLBACK_WAV], FALLBACK_WAV, "paplay (fallback wav)"
        return None

    def poll(self):
        """Reap finished players, apply the fallback chain, kill stuck ones."""
        now = self.clock.monotonic()
        keep, retries = [], []
        for child in self.children:
            proc = child["proc"]
            age = now - child["started"]
            rc = proc.poll()
            if rc is None:
                if age > ALERT_CHILD_TIMEOUT_S:
                    self.log.warn(f"WARN: alert player {child['stage']} still running "
                                  f"after {ALERT_CHILD_TIMEOUT_S} s; killed")
                    self._kill(proc)
                else:
                    keep.append(child)
                continue
            if rc == 0:
                continue
            nxt = self._next(child, age)
            if nxt is None:
                self.log.warn(f"WARN: alert player {child['stage']} failed "
                              f"(exit {rc}) on {child['path']}")
                continue
            self.log.warn(f"WARN: alert player {child['stage']} failed (exit {rc}) "
                          f"on {child['path']}; trying {nxt[2]}")
            retries.append(nxt)
        self.children = keep
        for argv, path, stage in retries:
            self._spawn(argv, path, stage)

    @staticmethod
    def _kill(proc):
        try:
            os.killpg(proc.pid, signal.SIGKILL)      # own session: pgid == pid
        except OSError:
            try:
                proc.kill()
            except OSError:
                pass
        try:
            proc.wait(timeout=1)
        except (OSError, subprocess.TimeoutExpired):
            pass

    def kill_all(self):
        for child in self.children:
            self._kill(child["proc"])
        self.children = []


class LiveHAL:
    """The real hardware behind the Controller's interface."""

    def __init__(self, log, alert_player=None):
        self.log = log
        self.alert_player = alert_player
        self.hwmon = Hwmon()

    def read_temps(self):
        return self.hwmon.temp("k10temp"), self.hwmon.temp("amdgpu")

    def read_ac(self):
        return read_text(AC_ONLINE) != "0"      # missing node -> AC (§4.3)

    def fan_write(self, command):
        """Every write is checked (§11): a sandbox that made /proc read-only must show."""
        data = command.encode("ascii")
        try:
            # O_TRUNC matches what v1's open(path, "w") and the shell's `>`
            # have always done on this procfs file; no O_CREAT, ever.
            fd = os.open(FAN_PROC, os.O_WRONLY | os.O_TRUNC)
            try:
                n = os.write(fd, data)
            finally:
                os.close(fd)
            if n != len(data):
                raise OSError(f"short write ({n} of {len(data)} bytes)")
            return True
        except OSError as e:
            self.log.error(f"ERROR: writing '{command}' to {FAN_PROC} failed: {e}")
            return False

    def fan_read(self):
        return parse_fan_proc(read_text(FAN_PROC))

    def play_alert(self, path):
        if self.alert_player is not None:
            self.alert_player.play(path)

    def read_config(self):
        return read_config_file()

    def config_mtime(self):
        try:
            return os.stat(CONFIG_FILE).st_mtime
        except OSError:
            return None

    def load_rpm(self):
        try:
            with open(os.path.join(STATE_DIR, "rpm.json"), encoding="utf-8") as f:
                data = json.load(f)
        except (OSError, ValueError):
            return {}
        out = {}
        if isinstance(data, dict):
            for level, rpm in data.items():
                if level in VALID_LEVELS and _as_int(rpm) is not None and 0 <= rpm < 20000:
                    out[level] = int(rpm)
        return out

    def save_rpm(self, rpm_by_level):
        try:
            write_json_atomic(os.path.join(STATE_DIR, "rpm.json"), rpm_by_level)
        except OSError as e:
            # Best effort (§4.11): a missing StateDirectory is not fatal.
            self.log.warn(f"WARN: cannot persist rpm.json in {STATE_DIR}: {e}")

# ── end of section: hardware ──


# ── Controller ───────────────────────────────────────────────────────────────

def _r1(value):
    return None if value is None else round(value, 1)


def _f1(value):
    return "n/a" if value is None else f"{value:.1f}"


def _error(code, message):
    return {"ok": False, "error": code, "message": message}


class Controller:
    """
    The decision logic of §4.  Everything it touches goes through `hal`
    (sensors, fan, AC, config file, alerts, rpm store) and `clock`, so the live
    daemon, --simulate and the unit tests all drive exactly this class.

    Clocks: clock.monotonic() for dwell / spacing / hold / cooldown math,
    clock.time() only for epoch fields (override.until, level_since, ts, log).
    """

    def __init__(self, cfg, hal, clock, log, *, cfg_mtime=None, cfg_schema=2,
                 initial_level=None, rpm_by_level=None, pid=0, record=False):
        self.cfg = cfg
        self.hal = hal
        self.clock = clock
        self.log = log
        self.pid = pid
        now = clock.monotonic()
        # sensors and filters
        self.cpu = self.igpu = self.raw = None
        self.t_fast = self.t_slow = None
        self.missing = 0
        self.sensor_lost = False
        # power source (§4.3 debounce)
        self.on_ac = True
        self._ac_seen = False
        self._ac_candidate = None
        self._ac_count = 0
        # curve position
        self.idx = 0
        self.last_up = now
        self.last_change = now
        self._tick_cause = None
        self._was_top = None
        self._top_entries = collections.deque()
        # critical
        self.critical = False
        self.critical_since = None          # epoch, for state.json
        self.critical_since_mono = None
        self.crit_streak = 0
        self.episode_alerts = 0
        self.alerts_total = 0
        self.last_alert_mono = None
        self._test_alert_mono = None
        # override (in memory only, §7)
        self.override = None
        # fan
        self.level = initial_level          # last level successfully written
        self.reason = "curve"
        self.level_since = clock.time()
        self.level_since_mono = now
        self.last_write_mono = None
        self.level_proc = None
        self.rpm = None
        self.fan_status = None
        self.fan_control_available = False
        self.external_until = None
        self.watchdog_armed = None
        # rpm learning (§4.11)
        self.rpm_by_level = dict(rpm_by_level or {})
        self._rpm_saved = dict(self.rpm_by_level)
        self._rpm_samples = {}
        # config reload bookkeeping (§4.4)
        self.cfg_mtime = cfg_mtime
        self.cfg_schema = cfg_schema
        self._cfg_problem = None
        # publication (§5 / §6)
        self.samples = collections.deque(maxlen=HISTORY_SAMPLES)
        self.events = collections.deque(maxlen=HISTORY_EVENTS)
        self.history_dirty = False
        self.state_dirty = False
        # Transition records are for --simulate and tests only; the live
        # daemon runs for weeks and must not grow a list per change.
        self.record = record
        self.transitions = []
        self.ticks = 0

    # ── small helpers ────────────────────────────────────────────────────

    def dt(self):
        return self.cfg["sample_interval"]

    def curve_name(self):
        return "battery" if (not self.on_ac and self.cfg["use_battery_curve"]) else "ac"

    def curve(self):
        return self.cfg["battery_curve" if self.curve_name() == "battery" else "curve"]

    def release_temp(self, i):
        """Release temperature of step i (§3): explicit `down`, else temp - hysteresis."""
        if i <= 0:
            return None
        step = self.curve()[i]
        if "down" in step:
            return step["down"]
        return max(0, step["temp"] - self.cfg["hysteresis"])

    def curve_level(self):
        curve = self.curve()
        return curve[min(self.idx, len(curve) - 1)]["level"]

    def effective_watchdog(self):
        wd = self.cfg["watchdog"]
        return 0 if wd == 0 else max(wd, 3 * self.dt() + 15)

    def refresh_interval(self):
        # §4.9: rewrite an unchanged level well inside the EC watchdog window.
        wd = self.watchdog_armed if self.watchdog_armed is not None else self.effective_watchdog()
        return min(20, wd // 3) if wd > 0 else 30

    def event(self, kind, detail):
        self.events.append([round(self.clock.time(), 3), kind, detail])
        self.history_dirty = True

    def _set_idx(self, idx, cause):
        self.idx = idx
        self._tick_cause = cause

    def _reseat(self, now, cause):
        """
        §4.6 reseat(): the highest step whose threshold T_fast has reached,
        dwell clocks restarted.  Never touches the EMAs.
        """
        if self.t_fast is None:
            return
        curve = self.curve()
        self._set_idx(max(i for i, s in enumerate(curve) if s["temp"] <= self.t_fast), cause)
        self.last_up = now
        self.last_change = now

    def _step_text(self):
        curve = self.curve()
        n = len(curve)
        return f"step {min(self.idx, n - 1)}/{n} {self.curve_name()}"

    # ── lifecycle ────────────────────────────────────────────────────────

    def start(self):
        cfg = self.cfg
        wd = self.effective_watchdog()
        battery = curve_summary(cfg["battery_curve"])
        if not cfg["use_battery_curve"]:
            battery += " (unused)"
        self.log.info(
            f"Daemon v{VERSION} started (pid {self.pid}, sample {cfg['sample_interval']} s, "
            f"watchdog {str(wd) + ' s' if wd else 'off'}, critical {cfg['critical_temp']}, "
            f"ac {curve_summary(cfg['curve'])} | battery {battery})")
        self.event("daemon_start", f"v{VERSION}")
        self._arm_watchdog()

    def shutdown(self):
        """Hand the fan back to the firmware; the watchdog goes first (§4)."""
        self.log.info("Daemon stopping — returning fan to firmware control")
        self.hal.fan_write("watchdog 0")
        self.hal.fan_write("level auto")

    def prime(self):
        """
        --self-test: seed the filters and the curve position from one sample and
        read /proc, commanding nothing, so the published state shows what the
        daemon would do without touching the fan beyond the write-back.
        """
        now = self.clock.monotonic()
        self._read_temps()
        if self.raw is not None:
            self._update_power(now, initial=True)
            self.t_fast = self.t_slow = self.raw
            self._reseat(now, "start")
        self._observe_proc()

    # ── the tick ─────────────────────────────────────────────────────────

    def _read_temps(self):
        cpu, igpu = self.hal.read_temps()
        self.cpu = cpu if cpu is not None and 0 < cpu < 150 else None
        self.igpu = igpu if igpu is not None and 0 < igpu < 150 else None
        valid = [v for v in (self.cpu, self.igpu) if v is not None]
        self.raw = max(valid) if valid else None

    def tick(self):
        now = self.clock.monotonic()
        self.ticks += 1
        self._tick_cause = None
        self._read_temps()
        if self.raw is None:
            self._tick_without_sensor(now)            # §4.1
        else:
            self._tick_with_sensor(now)
        self._arm_watchdog()                          # §4.10
        self._check_proc(now)                         # §4.9
        self._learn_rpm(now)                          # §4.11
        self._track_top(now)                          # §4.13
        self.samples.append([round(self.clock.time(), 3), _r1(self.raw), _r1(self.t_fast),
                             _r1(self.t_slow), self.level, self.rpm, self.on_ac])

    def _tick_without_sensor(self, now):
        self.missing += 1
        self.crit_streak = 0               # a gap breaks "two consecutive samples"
        if not self.sensor_lost and self.missing >= 3:
            self.sensor_lost = True
            target = "disengaged" if self.critical else "auto"
            self.log.info(f"WARN: no valid temperature for {self.missing} samples; "
                          f"fan -> {target} until a sensor returns")
            self.event("sensor_lost", target)
        self._expire_override(now)
        if self.sensor_lost:
            # Guessing is the one dangerous thing here: firmware auto is safe,
            # and disengaged is the only safe answer during a critical episode.
            self._command("disengaged" if self.critical else "auto", "sensor_lost", now)
        elif self.level is not None:
            self._command(self.level, self.reason, now)   # keeps the watchdog fed

    def _tick_with_sensor(self, now):
        raw = self.raw
        if self.sensor_lost:                           # §4.1 recovery
            # Checked first: a loss that started before the first valid
            # sample (t_fast still None) is a recovery too, so it is logged
            # and sensor_lost is cleared on this very tick.
            first = self.t_fast is None
            self.sensor_lost = False
            self.missing = 0
            self._update_power(now, initial=first)
            self.t_fast = self.t_slow = raw
            self._reseat(now, "sensor_ok")
            self.log.info(f"Temperature sensors back (raw {raw:.1f}); re-seated at {self._step_text()}")
            self.event("sensor_ok", f"raw {raw:.1f}")
        elif self.t_fast is None:                      # first valid sample
            self._update_power(now, initial=True)      # the right curve for the seat
            self.t_fast = self.t_slow = raw
            self.missing = 0
            self._reseat(now, "start")
        else:                                          # §4.2 filters
            self.missing = 0
            dt = self.dt()
            a_up = 1.0 - math.exp(-dt / self.cfg["smoothing_up_s"])
            a_dn = 1.0 - math.exp(-dt / self.cfg["smoothing_down_s"])
            self.t_fast += a_up * (raw - self.t_fast)
            self.t_slow += a_dn * (raw - self.t_slow)
            self._update_power(now)                    # §4.3
        self._check_config(now)                        # §4.4
        self._critical(now)                            # §4.5
        self._evaluate_curve(now)                      # §4.6
        # §4.8 runs before §4.7's selection: a target taken from an override
        # that expires in this same tick would put a stale level on the fan.
        self._expire_override(now)
        self._update_suspension(now)                   # §4.7
        level, reason = self._select_target()
        self._command(level, reason, now)              # §4.9

    def _update_power(self, now, initial=False):
        ac = bool(self.hal.read_ac())
        if initial or not self._ac_seen:
            self._ac_seen = True
            self.on_ac = ac
            self._ac_candidate, self._ac_count = None, 0
            return
        if ac == self.on_ac:
            self._ac_candidate, self._ac_count = None, 0
            return
        if ac == self._ac_candidate:
            self._ac_count += 1
        else:
            self._ac_candidate, self._ac_count = ac, 1
        # The sysfs node bounces when the plug is wiggled: three identical
        # readings before anything switches.
        if self._ac_count < 3:
            return
        old_curve = self.curve_name()
        self.on_ac = ac
        self._ac_candidate, self._ac_count = None, 0
        self.log.info(f"Power -> {'AC' if ac else 'battery'}")
        self.event("ac", "AC" if ac else "battery")
        # Re-seat only when the curve in use actually changed: with
        # use_battery_curve off a plug event must not move the fan.
        if self.curve_name() != old_curve:
            self._reseat(now, "ac")

    def _check_config(self, now):
        mtime = self.hal.config_mtime()
        if mtime == self.cfg_mtime:
            return
        if mtime is None:
            if self._cfg_problem != "missing":
                self._cfg_problem = "missing"
                self.log.info("WARN: config file disappeared; keeping the running config")
            self.cfg_mtime = None
            return
        raw, read_mtime, err = self.hal.read_config()
        self.cfg_mtime = read_mtime if read_mtime is not None else mtime
        if raw is None:
            problem = (self.cfg_mtime, err)
            if self._cfg_problem != problem:
                self._cfg_problem = problem
                self.log.info(f"WARN: config reload failed ({err}); keeping the running config")
            return
        self._cfg_problem = None
        self.cfg_schema = _as_int(raw.get("schema")) if "schema" in raw else 1
        new = config_from_disk(raw, self.cfg, self.log.once)
        if new == self.cfg:
            return
        self.cfg = new
        self.log.info(f"Config reloaded (sample {new['sample_interval']} s, watchdog "
                      f"{new['watchdog'] or 'off'}, critical {new['critical_temp']}, "
                      f"ac {curve_summary(new['curve'])} | battery {curve_summary(new['battery_curve'])})")
        self.event("config", "reloaded")
        self._reseat(now, "config")
        self.state_dirty = True

    def _critical(self, now):
        cfg = self.cfg
        crit = cfg["critical_temp"]
        raw = self.raw
        self.crit_streak = self.crit_streak + 1 if raw >= crit else 0
        if not self.critical:
            # Entry stays on raw samples, never on an EMA: two consecutive hits
            # filter the 1 s Tctl spikes, +3 once catches a genuine runaway.
            if self.crit_streak >= 2 or raw >= crit + 3:
                self.critical = True
                self.critical_since = self.clock.time()
                self.critical_since_mono = now
                self.episode_alerts = 0
                self.log.info(f"CRITICAL entered (raw {raw:.1f} fast {self.t_fast:.1f} "
                              f"slow {self.t_slow:.1f})")
                self.event("critical_on", f"raw {raw:.1f}")
                self.state_dirty = True
                self._maybe_alert(now)
            return
        if (self.t_slow < crit - cfg["critical_exit_margin"]
                and now - self.critical_since_mono >= cfg["critical_exit_hold_s"]):
            # Amended §4.5: leave onto the TOP step with fresh dwell clocks and
            # let the normal DOWN rules walk it down.  reseat() by T_fast here
            # dropped straight to level 7, re-heated and re-entered critical.
            self.critical = False
            self.critical_since = None
            self.critical_since_mono = None
            n = len(self.curve())
            self._set_idx(n - 1, "critical_exit")
            self.last_up = now
            self.last_change = now
            # Two decimals and the limit: at one decimal a slow EMA of 81.96
            # prints as "82.0" and the line would seem to contradict the rule.
            self.log.info(f"CRITICAL cleared (slow {self.t_slow:.2f} < "
                          f"{crit - cfg['critical_exit_margin']}) -> top step ({self._step_text()})")
            self.event("critical_off", f"slow {self.t_slow:.1f}")
            self.state_dirty = True
            return
        self._maybe_alert(now)

    def _maybe_alert(self, now):
        cfg = self.cfg
        if not cfg["alerts_enabled"]:
            return
        if self.last_alert_mono is not None and now - self.last_alert_mono < cfg["alert_cooldown"]:
            return
        self.last_alert_mono = now
        self.episode_alerts += 1
        self.alerts_total += 1
        self.hal.play_alert(cfg["alert_sound"])
        since = time.strftime("%H:%M:%S", time.localtime(self.critical_since))
        # Never "raw X at or above critical": on a repeat alert the current
        # raw may already be below the threshold (amended §4.5).
        self.log.info(f"ALERT: critical since {since} (raw {self.raw:.1f}, slow {self.t_slow:.1f})")
        self.event("alert", f"raw {self.raw:.1f}")

# ── end of section: controller part 1 ──

    # ── Controller, part 2: curve, override, fan ─────────────────────────

    def _evaluate_curve(self, now):
        """
        §4.6: always evaluated, even while critical or an override commands the
        fan, so curve_level is always "what the curve would do".  One UP step
        per tick on T_fast; DOWN on T_slow, gated by dwell since the last UP
        and spacing since the last change.
        """
        cfg = self.cfg
        curve = self.curve()
        n = len(curve)
        if self.idx >= n:
            self._set_idx(n - 1, "clamp")
        if self.idx + 1 < n and self.t_fast >= curve[self.idx + 1]["temp"]:
            self._set_idx(self.idx + 1, "up")
            self.last_up = now
            self.last_change = now
        elif (self.idx > 0 and self.t_slow < self.release_temp(self.idx)
              and now - self.last_up >= cfg["dwell_down_s"]
              and now - self.last_change >= cfg["step_down_spacing_s"]):
            self._set_idx(self.idx - 1, "down")
            self.last_change = now

    def _expire_override(self, now):
        ov = self.override
        if ov is not None and ov["until"] <= self.clock.time():
            self.override = None
            self.log.info(f"Override {ov['level']} ended (expired)")
            self.event("override_end", f"{ov['level']} expired")
            self._reseat(now, "override_end")
            self.state_dirty = True

    def _update_suspension(self, now):
        """
        Amended §4.7 envelope: suspend on T_fast (a single Tctl spike on raw
        flapped 3 -> disengaged -> 3 within 2 s in simulation), resume on
        T_slow below ceiling - hysteresis and only after 30 s suspended.

        Evaluated every tick an override exists, critical included: an
        override left unsuspended through a critical episode would put the
        low level back on the fan the moment critical clears, which is the
        re-heating cycle the envelope exists to prevent.
        """
        ov = self.override
        if ov is None or ov["level"] == "auto" or self.t_fast is None:
            return
        cfg = self.cfg
        ceiling = cfg["override_ceiling_temp"]
        if not ov["suspended"]:
            wanted = self.curve_level()
            if self.t_fast >= ceiling and RANK[wanted] > RANK[ov["level"]]:
                ov["suspended"] = True
                ov["suspended_at"] = now
                self.log.info(f"Override {ov['level']} suspended (fast {self.t_fast:.1f} >= "
                              f"ceiling {ceiling}; curve wants {wanted})")
                self.state_dirty = True
        elif (self.t_slow < ceiling - cfg["hysteresis"]
              and now - ov["suspended_at"] >= SUSPEND_MIN_S):
            ov["suspended"] = False
            ov["suspended_at"] = None
            self.log.info(f"Override {ov['level']} resumed (slow {self.t_slow:.2f} < "
                          f"{ceiling - cfg['hysteresis']})")
            self.state_dirty = True

    def _select_target(self):
        """§4.7: first match wins."""
        if self.critical:
            return "disengaged", "critical"
        ov = self.override
        if ov is not None:
            if not ov["suspended"]:
                return ov["level"], "override"
            return self.curve_level(), "override_suspended_hot"
        return self.curve_level(), "curve"

    def _command(self, level, reason, now):
        """
        §4.9 Fan.set(): write on a change, or when the refresh interval has
        elapsed (which also feeds the EC watchdog).  Refreshes are not logged.
        A failed write leaves the commanded level unchanged, so it is retried
        on the next tick; the HAL logs the failure (rate-limited).
        """
        self.reason = reason
        changed = level != self.level
        due = self.last_write_mono is None or now - self.last_write_mono >= self.refresh_interval()
        if not (changed or due):
            return
        if not self.hal.fan_write(f"level {level}"):
            return
        self.last_write_mono = now
        if not changed:
            return
        old = self.level
        self.level = level
        self.level_since = self.clock.time()
        self.level_since_mono = now
        self.log.info(self._change_line(old, level, reason))
        self.event("level", f"{old if old is not None else '?'}->{level}")
        self.state_dirty = True
        if self.record:
            self.transitions.append({
                "t": now, "from": old, "to": level, "reason": reason,
                "cause": self._tick_cause or reason, "raw": _r1(self.raw),
                "fast": _r1(self.t_fast), "slow": _r1(self.t_slow),
                "idx": self.idx, "curve": self.curve_name()})

    def _change_line(self, old, new, reason):
        """Dense §10 format, e.g. `Fan 7 -> disengaged (raw 81.2 fast 80.1 slow 77.9 |
        step 4/5 ac | up>=80 down<72) [curve]`."""
        curve = self.curve()
        n = len(curve)
        i = min(self.idx, n - 1)
        if i > 0:
            thresholds = f"up>={curve[i]['temp']} down<{self.release_temp(i)}"
        elif n > 1:
            thresholds = f"next>={curve[1]['temp']}"
        else:
            thresholds = "single step"
        return (f"Fan {old if old is not None else '?'} -> {new} (raw {_f1(self.raw)} "
                f"fast {_f1(self.t_fast)} slow {_f1(self.t_slow)} | {self._step_text()} | "
                f"{thresholds}) [{reason}]")

    def _arm_watchdog(self):
        """§4.10: write `watchdog n` at start and whenever the effective value changes."""
        n = self.effective_watchdog()
        if n == self.watchdog_armed:
            return
        if self.hal.fan_write(f"watchdog {n}"):
            previous = self.watchdog_armed
            self.watchdog_armed = n
            if previous is not None:          # the startup line already says it
                self.log.info(f"EC watchdog set to {n} s" if n else "EC watchdog disabled")

    def _observe_proc(self):
        info = self.hal.fan_read() or {}
        self.level_proc = info.get("level")
        self.rpm = info.get("speed")
        self.fan_status = info.get("status")
        self.fan_control_available = bool(info.get("control_available"))
        return info

    def _check_proc(self, now):
        """
        §4.9: compare what the EC reports with what we commanded.  `auto` is
        what a watchdog revert reads, so only other mismatches count as an
        external write (logged once per 60 s episode); either way our level
        is written again.
        """
        self._observe_proc()
        if self.external_until is not None and now >= self.external_until:
            self.external_until = None
        if self.level is None or self.level_proc is None or same_level(self.level_proc, self.level):
            return
        if self.level_proc != "auto":
            if self.external_until is None:
                self.log.info(f"external fan write detected (level {self.level_proc})")
            self.external_until = now + EXTERNAL_WRITE_FLAG_S
            self.state_dirty = True
        if self.hal.fan_write(f"level {self.level}"):
            self.last_write_mono = now

    def _learn_rpm(self, now):
        """§4.11: median EC speed per level, after >= 20 s at that level."""
        level = self.level
        if (level in (None, "auto") or self.rpm is None or self.external_until is not None
                or self.level_proc is None or not same_level(self.level_proc, level)
                or now - self.level_since_mono < RPM_LEARN_AFTER_S):
            return
        samples = self._rpm_samples.setdefault(level, collections.deque(maxlen=RPM_SAMPLES))
        samples.append(self.rpm)
        median = int(round(statistics.median(samples)))
        self.rpm_by_level[level] = median
        saved = self._rpm_saved.get(level)
        if saved is None or abs(median - saved) >= RPM_PERSIST_DELTA:
            self._rpm_saved[level] = median
            self.hal.save_rpm(dict(self.rpm_by_level))

    def _track_top(self, now):
        """§4.13: entries into the last curve step (any cause) within 600 s."""
        n = len(self.curve())
        at_top = n > 1 and self.idx == n - 1
        if at_top and self._was_top is False:
            self._top_entries.append(now)
        self._was_top = at_top
        while self._top_entries and now - self._top_entries[0] > TOP_CYCLE_WINDOW_S:
            self._top_entries.popleft()

    # ── control socket commands (§7) ─────────────────────────────────────

    def handle_request(self, data, uid):
        try:
            req = json.loads(data.decode("utf-8") if isinstance(data, (bytes, bytearray)) else data)
        except (ValueError, UnicodeDecodeError):
            return _error("bad_request", "Request is not valid JSON.")
        if not isinstance(req, dict):
            return _error("bad_request", "Request must be a JSON object.")
        cmd = req.get("cmd")
        if cmd == "hold":
            return self.cmd_hold(req.get("level"), req.get("seconds", 0), uid)
        if cmd == "resume":
            return self.cmd_resume(uid)
        if cmd == "status":
            return {"ok": True, "state": self.state()}
        if cmd == "test_alert":
            return self.cmd_test_alert(uid)
        return _error("bad_request", "Unknown command; expected hold, resume, status or test_alert.")

    def cmd_hold(self, level, seconds, uid):
        if not isinstance(level, str) or level not in VALID_LEVELS:
            return _error("bad_request", "Level must be one of: " + ", ".join(LEVELS) + ".")
        secs = _as_int(seconds)
        if secs is None or secs < 0:
            return _error("bad_request", "Seconds must be a non-negative integer.")
        now = self.clock.monotonic()
        info = self._observe_proc()
        if not info.get("control_available"):
            # Only the missing `commands: level` line means this; `status:
            # disabled` merely says the fan is currently stopped at level 0.
            return _error("fan_control_unavailable",
                          "thinkpad_acpi offers no fan level control (no 'commands: level' line "
                          "in /proc/acpi/ibm/fan); load it with fan_control=1.")
        if level == "0" and (self.raw is None or self.raw >= FAN_OFF_MAX_TEMP):
            # Unknown temperature is treated as hot: fan-off needs proof it is cool.
            return _error("too_hot_for_fan_off",
                          f"Fan off is only allowed below {FAN_OFF_MAX_TEMP} °C "
                          f"(now {_f1(self.raw)}).")
        limit = self.cfg["override_max_seconds"]
        secs = limit if secs == 0 else min(secs, limit)
        wall = self.clock.time()
        self.override = {"level": level, "until": wall + secs, "set_at": wall,
                         "suspended": False, "suspended_at": None, "uid": uid}
        self.log.info(f"Override {level} for {secs}s (uid {uid})")
        self.event("override_start", f"{level} {secs}s")
        self._apply_now(now)
        return {"ok": True, "state": self.state()}

    def cmd_resume(self, uid):
        now = self.clock.monotonic()
        ov = self.override
        if ov is not None:
            self.override = None
            self.log.info(f"Override {ov['level']} ended (resumed by uid {uid})")
            self.event("override_end", f"{ov['level']} resumed")
        self._reseat(now, "resume")
        self._apply_now(now)
        return {"ok": True, "state": self.state()}

    def cmd_test_alert(self, uid):
        now = self.clock.monotonic()
        if (self._test_alert_mono is not None
                and now - self._test_alert_mono < TEST_ALERT_MIN_GAP_S):
            return _error("rate_limited", f"One test alert per {TEST_ALERT_MIN_GAP_S} s.")
        self._test_alert_mono = now
        self.hal.play_alert(self.cfg["alert_sound"])
        self.log.info(f"Test alert (uid {uid})")
        return {"ok": True}

    def _apply_now(self, now):
        """Target selection + fan write outside the sample schedule (no EMA step)."""
        self.state_dirty = True
        if self.t_fast is None:
            return
        if self.sensor_lost:
            self._command("disengaged" if self.critical else "auto", "sensor_lost", now)
        else:
            self._update_suspension(now)
            level, reason = self._select_target()
            self._command(level, reason, now)
        self._check_proc(now)

    # ── publication (§5 / §6) ────────────────────────────────────────────

    def dwell_remaining(self, now):
        if self.idx == 0:
            return 0
        wait = max(self.cfg["dwell_down_s"] - (now - self.last_up),
                   self.cfg["step_down_spacing_s"] - (now - self.last_change), 0.0)
        return int(math.ceil(wait))

    def top_cycles_10min(self, now):
        return sum(1 for t in self._top_entries if now - t <= TOP_CYCLE_WINDOW_S)

    def state(self):
        now = self.clock.monotonic()
        wall = self.clock.time()
        cfg = self.cfg
        curve = self.curve()
        n = len(curve)
        i = min(self.idx, n - 1)
        ov = None
        if self.override is not None:
            o = self.override
            ov = {"level": o["level"], "until": o["until"], "set_at": o["set_at"],
                  "remaining_s": max(0, int(math.ceil(o["until"] - wall))),
                  "suspended": o["suspended"]}
        return {
            "schema": 1, "version": VERSION, "pid": self.pid,
            "ts": wall, "mono": now, "sample_interval": cfg["sample_interval"],
            "sensor_ok": self.raw is not None,
            "temp_raw": _r1(self.raw), "temp_fast": _r1(self.t_fast), "temp_slow": _r1(self.t_slow),
            "cpu": _r1(self.cpu), "igpu": _r1(self.igpu),
            "level": self.level, "level_proc": self.level_proc, "rpm": self.rpm,
            "fan_control_available": self.fan_control_available, "fan_status": self.fan_status,
            "reason": self.reason, "on_ac": self.on_ac, "curve": self.curve_name(),
            "step_index": i, "steps": n, "curve_level": curve[i]["level"],
            "up_at": curve[i + 1]["temp"] if i + 1 < n else None,
            "down_below": self.release_temp(i),
            "level_since": self.level_since,
            "dwell_remaining_s": self.dwell_remaining(now),
            # alerts: alerts played in the current (or last) critical episode.
            "critical": {"active": self.critical, "since": self.critical_since,
                         "alerts": self.episode_alerts},
            "override": ov,
            "watchdog": (self.watchdog_armed if self.watchdog_armed is not None
                         else self.effective_watchdog()),
            "hysteresis": cfg["hysteresis"], "critical_temp": cfg["critical_temp"],
            "config_mtime": self.cfg_mtime, "config_schema": self.cfg_schema,
            "rpm_by_level": dict(self.rpm_by_level),
            "top_cycles_10min": self.top_cycles_10min(now),
            "external_write_detected": self.external_until is not None,
        }

    def history(self):
        return {"schema": 1, "sample_interval": self.cfg["sample_interval"],
                "samples": list(self.samples), "events": list(self.events)}

# ── end of section: controller part 2 ──


# ── Live daemon ──────────────────────────────────────────────────────────────

class ControlServer:
    """
    §7 control socket.  Connections are handled inline in the selectors loop
    (no threads): one request line in, one JSON line out, close.  The peer's
    uid comes from SO_PEERCRED, i.e. from the kernel, not from the request.
    """

    def __init__(self, path, gui, ctrl, log):
        self.path = path
        self.gui = gui
        self.ctrl = ctrl
        self.log = log
        self.sock = None

    def open(self):
        try:
            os.unlink(self.path)             # stale socket from a crashed run
        except FileNotFoundError:
            pass
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.bind(self.path)
            if os.geteuid() == 0:
                os.chown(self.path, 0, self.gui.gid)
            os.chmod(self.path, 0o660)
            sock.listen(4)
            sock.setblocking(False)
        except OSError:
            sock.close()
            raise
        self.sock = sock

    def close(self):
        if self.sock is not None:
            self.sock.close()
            self.sock = None
            try:
                os.unlink(self.path)
            except OSError:
                pass

    def _read_line(self, conn):
        """Up to 4096 bytes up to the first newline, within 0.5 s in total."""
        deadline = time.monotonic() + SOCKET_TIMEOUT_S
        buf = b""
        while b"\n" not in buf:
            if len(buf) >= SOCKET_MAX_REQUEST:
                return None
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("request not completed in time")
            conn.settimeout(remaining)
            chunk = conn.recv(SOCKET_MAX_REQUEST - len(buf))
            if not chunk:
                return buf
            buf += chunk
        return buf.split(b"\n", 1)[0]

    def handle(self):
        """Serve one pending connection.  Returns True when a request was answered."""
        try:
            conn, _addr = self.sock.accept()
        except (BlockingIOError, InterruptedError):
            return False
        except OSError as e:
            self.log.warn(f"WARN: control socket accept failed: {e}")
            return False
        with conn:
            try:
                conn.settimeout(SOCKET_TIMEOUT_S)
                creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                        struct.calcsize("3i"))
                _pid, uid, _gid = struct.unpack("3i", creds)
                if uid not in (0, self.gui.uid):
                    return False                 # §7: close silently
                line = self._read_line(conn)
                if line is None:
                    reply = _error("bad_request", f"Request longer than {SOCKET_MAX_REQUEST} bytes.")
                else:
                    try:
                        reply = self.ctrl.handle_request(line, uid)
                    except Exception as e:
                        # The socket is a convenience; the curve, critical
                        # protection and the watchdog are not.  A bug in a
                        # command handler must never end the control loop
                        # (the caller of handle() does not catch).
                        self.log.error(f"ERROR: control request failed: {type(e).__name__}: {e}")
                        reply = _error("internal_error", "The daemon could not process the request; "
                                       "see /var/log/thinkpad-fan-control.log.")
                conn.sendall((json.dumps(reply, separators=(",", ":")) + "\n").encode("utf-8"))
                return True
            except (OSError, ValueError, struct.error):
                return False                     # peer vanished / timed out / sent garbage
            except Exception as e:
                self.log.error(f"ERROR: control connection failed: {type(e).__name__}: {e}")
                return False


class LiveDaemon:
    """The selectors loop: ticks on schedule, socket requests in between."""

    def __init__(self, ctrl, log, run_dir, server=None, alert_player=None, clock=None):
        self.ctrl = ctrl
        self.log = log
        self.run_dir = run_dir
        self.server = server
        self.alert_player = alert_player
        self.clock = clock or SystemClock()
        self.state_path = os.path.join(run_dir, "state.json")
        self.history_path = os.path.join(run_dir, "history.json")
        self._stop = False
        self._wake_r, self._wake_w = os.pipe()
        os.set_blocking(self._wake_r, False)
        os.set_blocking(self._wake_w, False)

    def request_stop(self, *_args):
        """Signal handler and test hook: wakes the selector through a pipe."""
        self._stop = True
        try:
            os.write(self._wake_w, b"x")
        except OSError:
            pass

    def publish_state(self):
        try:
            write_json_atomic(self.state_path, self.ctrl.state())
            self.ctrl.state_dirty = False
        except OSError as e:
            self.log.error(f"ERROR: cannot write {self.state_path}: {e}")

    def publish_history(self):
        try:
            write_json_atomic(self.history_path, self.ctrl.history())
            self.ctrl.history_dirty = False
        except OSError as e:
            self.log.error(f"ERROR: cannot write {self.history_path}: {e}")

    def remove_files(self):
        # The RuntimeDirectory disappears with the unit anyway; this also
        # covers a manual run, so a stopped daemon never looks alive.
        for path in (self.state_path, self.history_path):
            try:
                os.unlink(path)
            except OSError:
                pass

    def close(self):
        for fd in (self._wake_r, self._wake_w):
            try:
                os.close(fd)
            except OSError:
                pass

    def run(self):
        """Returns the exit code: 0 on a requested stop, 1 after repeated tick failures."""
        ctrl = self.ctrl
        sel = selectors.DefaultSelector()
        sel.register(self._wake_r, selectors.EVENT_READ, "wake")
        if self.server is not None and self.server.sock is not None:
            sel.register(self.server.sock, selectors.EVENT_READ, "sock")
        now = self.clock.monotonic()
        next_tick = now + ctrl.dt()
        next_ping = now + SD_WATCHDOG_PING_S
        last_history = now
        failures = 0
        try:
            while not self._stop:
                now = self.clock.monotonic()
                timeout = max(0.0, min(next_tick, next_ping, last_history + HISTORY_WRITE_S) - now)
                if self.alert_player is not None and self.alert_player.children:
                    timeout = min(timeout, 0.5)
                for key, _mask in sel.select(timeout):
                    if key.data == "wake":
                        try:
                            os.read(self._wake_r, 512)
                        except OSError:
                            pass
                    elif key.data == "sock" and self.server.handle():
                        # §4.12: publish right after a hold / resume, so the
                        # caller's next read of state.json is already true.
                        if ctrl.state_dirty:
                            self.publish_state()
                        if ctrl.history_dirty:
                            self.publish_history()
                            last_history = self.clock.monotonic()
                if self._stop:
                    break
                now = self.clock.monotonic()
                if now >= next_tick:
                    try:
                        ctrl.tick()
                        failures = 0
                    except Exception as e:      # keep feeding systemd only while ticks work
                        failures += 1
                        self.log.error(f"ERROR: control tick failed: {type(e).__name__}: {e}")
                        if failures >= MAX_TICK_FAILURES:
                            self.log.info(f"FATAL: {failures} consecutive tick failures; exiting")
                            return 1
                    self.publish_state()
                    next_tick += ctrl.dt()
                    if next_tick <= now:        # fell behind: do not burst to catch up
                        next_tick = now + ctrl.dt()
                if ctrl.history_dirty or now - last_history >= HISTORY_WRITE_S:
                    self.publish_history()
                    last_history = now
                if now >= next_ping:
                    sd_notify("WATCHDOG=1")
                    next_ping = now + SD_WATCHDOG_PING_S
                if self.alert_player is not None:
                    self.alert_player.poll()
            return 0
        finally:
            sel.close()


def _fake_paths_in_use():
    return FAN_PROC != "/proc/acpi/ibm/fan"


def wait_for_hardware(hal, log):
    """Startup wait (§4): up to 60 s in 2 s steps for /proc and a readable sensor."""
    deadline = time.monotonic() + HARDWARE_WAIT_S
    announced = False
    while True:
        have_proc = os.path.exists(FAN_PROC)
        cpu, igpu = hal.read_temps()
        have_sensor = cpu is not None or igpu is not None
        if have_proc and have_sensor:
            return True
        if time.monotonic() >= deadline:
            missing = ([] if have_proc else [FAN_PROC]) + ([] if have_sensor else ["k10temp/amdgpu sensor"])
            log.info(f"FATAL: {' and '.join(missing)} not available after {HARDWARE_WAIT_S} s")
            return False
        if not announced:
            log.info(f"Waiting up to {HARDWARE_WAIT_S} s for {FAN_PROC} and a temperature sensor")
            announced = True
        time.sleep(HARDWARE_WAIT_STEP_S)


def fan_self_test(hal, log):
    """
    §4 self-test: read the current level and write it back.  A sandbox that
    made /proc/acpi/ibm/fan read-only, or thinkpad_acpi without fan_control=1,
    fails here, loudly, instead of leaving a fan nobody controls.

    Returns the level written back (what the EC holds as the daemon takes
    over), or None on failure.
    """
    info = hal.fan_read()
    level = info.get("level")
    if level not in VALID_LEVELS:
        log.info(f"FATAL: {FAN_PROC} reports level {level!r}; refusing to take over")
        return None
    if not hal.fan_write(f"level {level}"):
        hint = ("" if info.get("control_available") else
                " (no 'commands: level' line: is thinkpad_acpi loaded with fan_control=1?)")
        log.info(f"FATAL: self-test write 'level {level}' to {FAN_PROC} failed{hint}")
        return None
    return level


def _require_root(log):
    # Only root can write the EC.  A non-root run is refused before any write
    # is attempted, unless the test-suite pointed us at a fake /proc file.
    if os.geteuid() != 0 and not _fake_paths_in_use():
        log.info("FATAL: thinkpad-fan-controld must run as root (systemd unit)")
        sys.stderr.write("thinkpad-fan-controld: must run as root\n")
        return False
    return True


def run_daemon():
    log = Log(LOG_FILE)
    if not _require_root(log):
        return 1
    gui = GuiIdentity()
    clock = SystemClock()
    player = AlertPlayer(gui, log, clock)
    hal = LiveHAL(log, player)
    if not wait_for_hardware(hal, log):
        return 1
    level = fan_self_test(hal, log)
    if level is None:
        return 1
    cfg, mtime, schema = load_config(log)
    ctrl = Controller(cfg, hal, clock, log, cfg_mtime=mtime, cfg_schema=schema,
                      initial_level=level, rpm_by_level=hal.load_rpm(), pid=os.getpid())
    server = None
    try:
        os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
        server = ControlServer(os.path.join(RUN_DIR, "control.sock"), gui, ctrl, log)
        server.open()
    except OSError as e:
        # Curve, critical and watchdog still work without the socket, so
        # this is loud but not fatal.
        log.error(f"ERROR: control socket unavailable: {e}")
        server = None
    daemon = LiveDaemon(ctrl, log, RUN_DIR, server, player, clock)
    signal.signal(signal.SIGTERM, daemon.request_stop)
    signal.signal(signal.SIGINT, daemon.request_stop)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)   # the default action would skip cleanup
    code = 1
    try:
        ctrl.start()
        ctrl.tick()
        daemon.publish_state()
        daemon.publish_history()
        sd_notify("READY=1")
        code = daemon.run()
    except Exception as e:
        log.info(f"FATAL: {type(e).__name__}: {e}")
        code = 1
    finally:
        sd_notify("STOPPING=1")
        ctrl.shutdown()
        player.kill_all()
        if server is not None:
            server.close()
        daemon.remove_files()
        daemon.close()
    return code


def self_test_main():
    """
    `--self-test` (§13): hardware wait, level write-back, one state.json in
    $RUNTIME_DIRECTORY or /tmp.  Commands nothing else and never plays sound.
    """
    log = Log(LOG_FILE)
    if not _require_root(log):
        return 1
    hal = LiveHAL(log, alert_player=None)
    if not wait_for_hardware(hal, log):
        return 1
    level = fan_self_test(hal, log)
    if level is None:
        return 1
    cfg, mtime, schema = load_config(log)
    ctrl = Controller(cfg, hal, SystemClock(), log, cfg_mtime=mtime, cfg_schema=schema,
                      initial_level=level, rpm_by_level=hal.load_rpm(), pid=os.getpid())
    ctrl.prime()
    path = os.path.join(_systemd_dir("RUNTIME_DIRECTORY") or "/tmp", "state.json")
    try:
        write_json_atomic(path, ctrl.state())
    except OSError as e:
        log.info(f"FATAL: self-test cannot write {path}: {e}")
        return 1
    msg = (f"Self-test OK (level {level} written back, rpm {ctrl.rpm}, raw {_f1(ctrl.raw)}, "
           f"would use {ctrl.curve_level()} at {ctrl._step_text()}; state {path})")
    log.info(msg)
    sys.stdout.write(msg + "\n")
    return 0

