SIM_EPOCH_BASE = 1_790_000_000.0     # wall-clock origin for traces with relative time

# First-order thermal model (§13): T' = (T_amb + P*R(level) - T) / (R(level)*C).
MODEL_C = 50.0                        # J/K
MODEL_T_AMB = 36.0                    # C
MODEL_THM = 95.0                      # SMU THM limit: the die cannot run hotter
# K/W.  auto, 3..7 and disengaged are the contract's values; 0..2 are not
# given there and are extrapolated so a curve using them still simulates.
MODEL_R = {"auto": 4.8, "0": 6.0, "1": 5.4, "2": 4.9, "3": 4.4, "4": 4.2, "5": 3.9,
           "6": 3.5, "7": 3.2, "disengaged": 2.25, "full-speed": 2.25}
# EC speed the fake fan reports.  7 and disengaged are measured on this unit;
# the rest are estimates that only feed the rpm-learning code path.
SIM_RPM = {"auto": 2600, "0": 0, "1": 1900, "2": 2300, "3": 2700, "4": 3000, "5": 3300,
           "6": 3600, "7": 4000, "disengaged": 6400, "full-speed": 6400}


def thermal_step(temp, power, level, dt):
    """Exact solution for constant P and level over dt, then the THM clamp."""
    r = MODEL_R.get(level, MODEL_R["auto"])
    target = MODEL_T_AMB + power * r
    return min(target + (temp - target) * math.exp(-dt / (r * MODEL_C)), MODEL_THM)


class FakeClock:
    def __init__(self, mono=0.0, epoch=SIM_EPOCH_BASE):
        self._mono = mono
        self._epoch = epoch

    def monotonic(self):
        return self._mono

    def time(self):
        return self._epoch

    def set(self, mono, epoch):
        self._mono, self._epoch = mono, epoch

    def advance(self, seconds):
        self._mono += seconds
        self._epoch += seconds


class SimHAL:
    """
    Fake hardware for --simulate and the unit tests.  Never touches /proc,
    /run, /var or the sound system: writes and alerts are only recorded.
    """

    def __init__(self, clock):
        self.clock = clock
        self.cpu = None
        self.igpu = None
        self.ac = True
        self.level = "auto"               # what the fake EC holds
        self.watchdog = 0
        self.write_ok = True
        self.control_available = True
        self.writes = []
        self.alerts = []
        self.saved_rpm = None
        self.cfg_mtime = None
        self.cfg_raw = None
        self.cfg_error = None

    def read_temps(self):
        return self.cpu, self.igpu

    def read_ac(self):
        return self.ac

    def fan_write(self, command):
        self.writes.append((self.clock.monotonic(), command))
        if not self.write_ok:
            return False
        if command.startswith("level "):
            self.level = command[6:]
        elif command.startswith("watchdog "):
            self.watchdog = int(command[9:])
        return True

    def fan_read(self):
        level = "disengaged" if self.level == "full-speed" else self.level
        return {"status": "disabled" if level == "0" else "enabled",
                "speed": SIM_RPM.get(level, 0), "level": level,
                "control_available": self.control_available}

    def play_alert(self, path):
        self.alerts.append((self.clock.monotonic(), path))

    def config_mtime(self):
        return self.cfg_mtime

    def read_config(self):
        return copy.deepcopy(self.cfg_raw), self.cfg_mtime, self.cfg_error

    def load_rpm(self):
        return {}

    def save_rpm(self, rpm_by_level):
        self.saved_rpm = dict(rpm_by_level)


class LegacyController:
    """
    The v1 rules, for comparison only (`--set legacy=1`): 3 s poll, integer
    temperatures, raw thresholds, 5 C hysteresis, critical on one raw sample,
    v1 default curves.  Mirrors backup-2026-09-23-pre-v2/daemon's pick_step().
    """

    POLL_S = 3

    def __init__(self, hal, clock, log):
        self.hal = hal
        self.clock = clock
        self.log = log
        self.cfg = {"sample_interval": self.POLL_S, "critical_temp": 90, "hysteresis": 5,
                    "alert_cooldown": 300, "curve": V1_DEFAULT_CURVE,
                    "battery_curve": V1_DEFAULT_BATTERY_CURVE}
        self.idx = 0
        self.level = "auto"
        self.reason = "curve"
        self.raw = self.t_fast = self.t_slow = None
        self.on_ac = True
        self._last_ac = None
        self.critical = False
        self.override = None
        self.sensor_lost = False
        self.alerts_total = 0
        self._last_alert = None
        self.record = True
        self.transitions = []
        self.events = collections.deque()

    def dt(self):
        return self.POLL_S

    def curve_name(self):
        return "ac" if self.on_ac else "battery"

    def start(self):
        pass

    def tick(self):
        now = self.clock.monotonic()
        vals = [int(v) for v in self.hal.read_temps() if v is not None and 0 < v < 150]
        self.raw = max(vals) if vals else None
        self.t_fast = self.t_slow = self.raw
        if self.raw is None:
            self.sensor_lost = True
            return self._set("auto", "sensor_lost", now)
        self.sensor_lost = False
        ac = self.hal.read_ac()
        if ac != self._last_ac:
            self._last_ac = ac
            self.on_ac = ac
            self.idx = 0
        curve = self.cfg["curve"] if self.on_ac else self.cfg["battery_curve"]
        if self.raw >= self.cfg["critical_temp"]:
            self.critical = True
            self.idx = len(curve) - 1
            if self._last_alert is None or now - self._last_alert >= self.cfg["alert_cooldown"]:
                self._last_alert = now
                self.alerts_total += 1
                self.hal.play_alert("legacy")
            return self._set("disengaged", "critical", now)
        self.critical = False
        idx = max(0, min(self.idx, len(curve) - 1))
        while idx + 1 < len(curve) and self.raw >= curve[idx + 1]["temp"]:
            idx += 1
        while idx > 0 and self.raw < curve[idx]["temp"] - self.cfg["hysteresis"]:
            idx -= 1
        self.idx = idx
        self._set(curve[idx]["level"], "curve", now)

    def _set(self, level, reason, now):
        self.reason = reason
        if level != self.level and self.hal.fan_write(f"level {level}"):
            self.log.info(f"[v1] Fan {self.level} -> {level} (raw {self.raw})")
            self.transitions.append({"t": now, "from": self.level, "to": level, "reason": reason,
                                     "cause": reason, "raw": self.raw, "fast": None,
                                     "slow": None, "idx": self.idx, "curve": self.curve_name()})
            self.level = level


def _truthy(value, default=True):
    if value is None or value.strip() == "":
        return default
    return value.strip().lower() not in ("0", "false", "no", "off")


def _float_or_none(value):
    try:
        f = float(value)
    except (TypeError, ValueError):
        return None
    return f if math.isfinite(f) else None


def _pick(row, names):
    for name in names:
        value = row.get(name)
        if value not in (None, ""):
            return value
    return None


def load_trace(path):
    """
    Trace rows: {t, cpu, igpu, ac, sensor_ok, cpu_ok, p_w, spike, model, hold}.

    CSV columns (§13): ts|t_s, cpu|tctl_c, igpu|gpu_c, ac, sensor_ok; extra
    columns are ignored except the ones --gen-trace writes for a closed-loop
    run: p_w (package power), spike_c (Tctl burst on top of the model
    temperature), model_c (model temperature, used to start the loop),
    cpu_ok (only the CPU sensor missing), hold_level / hold_seconds (a socket
    hold issued at that second).  history.json samples are also accepted.
    """
    rows = []
    if path.endswith(".json"):
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        for s in data.get("samples", []):
            if not isinstance(s, list) or len(s) < 7 or _float_or_none(s[0]) is None:
                continue
            raw = _float_or_none(s[1])
            rows.append({"t": float(s[0]), "cpu": raw, "igpu": None, "ac": bool(s[6]),
                         "sensor_ok": raw is not None, "cpu_ok": True, "p_w": None,
                         "spike": 0.0, "model": None, "hold": None})
        return rows
    with open(path, encoding="utf-8", newline="") as f:
        for raw in csv.DictReader(f):
            t = _float_or_none(_pick(raw, ("ts", "t_s")))
            if t is None:
                continue
            hold = None
            if _pick(raw, ("hold_level",)):
                hold = (raw["hold_level"].strip(),
                        int(_float_or_none(_pick(raw, ("hold_seconds",))) or 0))
            rows.append({
                "t": t,
                "cpu": _float_or_none(_pick(raw, ("cpu", "tctl_c"))),
                "igpu": _float_or_none(_pick(raw, ("igpu", "gpu_c"))),
                "ac": _truthy(raw.get("ac")),
                "sensor_ok": _truthy(raw.get("sensor_ok")),
                "cpu_ok": _truthy(raw.get("cpu_ok")),
                "p_w": _float_or_none(raw.get("p_w")),
                "spike": _float_or_none(raw.get("spike_c")) or 0.0,
                "model": _float_or_none(raw.get("model_c")),
                "hold": hold,
            })
    rows.sort(key=lambda r: r["t"])
    return rows


def simulate(rows, cfg, legacy=False, open_loop=False, echo=None, detail=False):
    """
    Run the exact decision code over a trace with a fake clock and a fake fan.

    Closed loop (the trace carries p_w, as --gen-trace output does): the die
    temperature follows the thermal model driven by the level the controller
    actually commands, so a what-if config changes the temperatures too.
    Open loop (recorded traces, or --open-loop): temperatures are replayed.
    """
    if not rows:
        raise ValueError("empty trace")
    t0 = rows[0]["t"]
    epoch0 = t0 if t0 > 1e9 else SIM_EPOCH_BASE + t0
    clock = FakeClock(0.0, epoch0)
    hal = SimHAL(clock)
    log = Log(None, clock, echo=echo, collect=detail)
    closed = not open_loop and any(r["p_w"] is not None for r in rows)
    if legacy:
        ctrl = LegacyController(hal, clock, log)
        cfg = dict(ctrl.cfg)
    else:
        ctrl = Controller(cfg, hal, clock, log, initial_level="auto", record=True)
    first = rows[0]
    temp = None
    if closed:
        temp = first["model"] if first["model"] is not None else (first["cpu"] or 45.0)
    hal.ac = first["ac"]
    ctrl.start()
    ticks = []
    next_tick = t0
    prev_t, prev_p = t0, first["p_w"]
    dt = ctrl.dt()
    for row in rows:
        t = row["t"]
        if closed:
            if t > prev_t and prev_p is not None:
                temp = thermal_step(temp, prev_p, hal.level, t - prev_t)
            cpu, igpu = temp + row["spike"], temp - 1.0
        else:
            cpu = row["cpu"]
            igpu = row["igpu"]
        if not row["sensor_ok"]:
            cpu = igpu = None
        elif not row["cpu_ok"]:
            cpu = None
        prev_t, prev_p = t, (row["p_w"] if row["p_w"] is not None else prev_p)
        hal.cpu, hal.igpu, hal.ac = cpu, igpu, row["ac"]
        clock.set(t - t0, epoch0 + (t - t0))
        if row["hold"] is not None and not legacy:
            req = {"cmd": "hold", "level": row["hold"][0], "seconds": row["hold"][1]}
            ctrl.handle_request(json.dumps(req), 1000)
        if t + 1e-9 < next_tick:
            continue
        ctrl.tick()
        next_tick += dt
        if next_tick <= t:
            next_tick = t + dt
        ov = ctrl.override
        # raw / fast / slow unrounded: acceptance checks compare them with the
        # very thresholds the controller used (slow 81.96 < 82 must not read
        # back as 82.0).
        ticks.append({"t": round(t - t0, 3), "raw": ctrl.raw, "fast": ctrl.t_fast,
                      "slow": ctrl.t_slow, "level": ctrl.level, "reason": ctrl.reason,
                      "idx": ctrl.idx, "critical": ctrl.critical, "ac": ctrl.on_ac,
                      "curve": ctrl.curve_name(), "sensor_lost": ctrl.sensor_lost,
                      "override": None if ov is None else ov["level"],
                      "suspended": bool(ov and ov["suspended"]),
                      "model": None if temp is None else round(temp, 2)})
    spacing = rows[1]["t"] - rows[0]["t"] if len(rows) > 1 else dt
    duration = max(rows[-1]["t"] - t0 + spacing, dt)
    summary = summarize(ctrl, ticks, duration, hal, cfg)
    summary["mode"] = "legacy" if legacy else "v2"
    summary["loop"] = "closed" if closed else "open"
    if detail:
        summary["ticks"] = ticks
        summary["events"] = [[round(e[0] - epoch0, 3), e[1], e[2]] for e in ctrl.events]
        summary["log"] = log.lines
    return summary


def summarize(ctrl, ticks, duration, hal, cfg):
    """§13 summary.  The startup seat (first tick) is not a decision under test."""
    start = ticks[0]["t"] if ticks else 0.0
    trans = [tr for tr in ctrl.transitions if tr["t"] > start]
    dwells = [b["t"] - a["t"] for a, b in zip(trans, trans[1:])]
    reversals = [b["t"] - a["t"] for a, b in zip(trans, trans[1:])
                 if a["from"] == b["to"] and a["to"] == b["from"]]
    share = collections.Counter()
    above = 0.0
    crit = cfg["critical_temp"]
    for i, tk in enumerate(ticks):
        span = (ticks[i + 1]["t"] if i + 1 < len(ticks) else duration) - tk["t"]
        share[str(tk["level"])] += span
        if tk["raw"] is not None and tk["raw"] >= crit:
            above += span
    total = sum(share.values()) or 1.0
    return {
        "duration_s": round(duration, 1),
        "ticks": len(ticks),
        "transitions": len(trans),
        "changes_per_hour": round(len(trans) * 3600.0 / duration, 2),
        "median_dwell_s": round(statistics.median(dwells), 1) if dwells else None,
        "min_dwell_s": round(min(dwells), 1) if dwells else None,
        "min_gap_opposite_s": round(min(reversals), 1) if reversals else None,
        "seconds_at_or_above_critical": round(above, 1),
        "time_share_per_level": {k: round(v / total, 4) for k, v in sorted(share.items())},
        "alerts": len(hal.alerts),
        "alert_times": [round(t, 3) for t, _p in hal.alerts],
        "final_level": ctrl.level,
        "fan_writes": len(hal.writes),
        "transition_list": [{**tr, "t": round(tr["t"], 3)} for tr in trans],
        "config": cfg,
    }


def print_summary(summary, out):
    out.write(f"\n=== summary ({summary['mode']}, {summary['loop']} loop) ===\n")
    for key in ("duration_s", "transitions", "changes_per_hour", "median_dwell_s",
                "min_dwell_s", "min_gap_opposite_s", "seconds_at_or_above_critical", "alerts",
                "final_level"):
        out.write(f"{key:>30}: {summary[key]}\n")
    out.write(f"{'time_share_per_level':>30}: " + ", ".join(
        f"{k}={v:.1%}" for k, v in summary["time_share_per_level"].items()) + "\n")

