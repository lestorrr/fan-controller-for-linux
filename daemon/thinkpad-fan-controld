def _systemd_dir(var):
    # systemd passes RUNTIME_DIRECTORY / STATE_DIRECTORY as a colon-separated
    # list when a unit declares several directories; this unit declares one.
    value = os.environ.get(var, "")
    return value.split(":")[0] or None


def _test_path(var, default):
    """
    FANCTL_* path overrides exist only so the offline test-suite can point the
    daemon at scratch files.  A root process ignores them: the daemon under
    systemd and --save-config under sudo always use the real paths, whatever
    ends up in their environment.
    """
    if os.geteuid() != 0:
        value = os.environ.get(var)
        if value:
            return value
    return default


